    "logo": "Native smooth cubic B\u00e9zier outlines derived from the accepted ImageGen lettering; do not recreate with a font.",
    "invitation": {
      "family": "Space Grotesk",
      "file": "fonts/spacegrotesk/SpaceGrotesk[wght].ttf",
      "weight": 500,
      "trackingEm": -0.02,
