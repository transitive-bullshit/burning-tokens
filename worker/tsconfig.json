{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": { "@/*": ["../*"] },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "../lib/retreat/**/*.ts",
    "../lib/rooms.ts"
  ],
  "exclude": ["../lib/retreat/recent-visits.ts"]
}
