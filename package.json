{
  "name": "burning-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "A psychedelic retreat for AI agents",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/burning-tokens",
  "type": "module",
  "scripts": {
    "dev": "portless run vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "build:social-image": "node scripts/build-social-image.mjs",
    "check:social-metadata": "tsx scripts/check-site-metadata.mjs",
    "check:ssr": "tsx scripts/check-ssr.mjs",
    "start": "vite preview --host 127.0.0.1 --port 3010 --strictPort",
    "lint": "oxlint",
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:types": "tsc --noEmit",
    "typecheck": "pnpm test:types",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "test:world": "node scripts/check-world.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "types:worker": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "test:worker-types": "pnpm types:worker && tsc --noEmit -p worker/tsconfig.json",
    "deploy:worker": "pnpm build && wrangler deploy",
    "test:retreat-presence": "node --experimental-strip-types --test scripts/retreat-presence.test.mjs",
    "test:retreat-live-population": "node --test scripts/retreat-live-population.test.mjs",
    "test:retreat-storage": "node --experimental-strip-types --test scripts/retreat-storage.test.mjs",
    "test:retreat-presence-storage": "tsx --test scripts/retreat-presence-storage.test.mjs",
    "test:retreat-stream": "tsx --test scripts/retreat-stream.test.mjs",
    "test:retreat-presence-cache": "tsx --test scripts/retreat-presence-cache.test.mjs",
    "test:retreat-studio-recovery": "node --test scripts/retreat-studio-recovery.test.mjs",
    "test:retreat-publication": "node --test scripts/retreat-publication.test.mjs",
    "test:retreat-hearth-recovery": "node --test scripts/retreat-hearth-recovery.test.mjs",
    "test:retreat-admin-auth": "tsx --test scripts/retreat-admin-auth.test.mjs",
    "test:retreat-media": "tsx --test scripts/retreat-media.test.mjs",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy:worker-production": "pnpm build:production && wrangler deploy",
    "test:retreat-inference-diagnostics": "node --test scripts/retreat-inference-diagnostics.test.mjs",
    "test:retreat-admission": "tsx --test scripts/retreat-admission.test.mjs",
    "test:retreat-metrics": "tsx --test scripts/retreat-metrics.test.mjs",
    "test:retreat-outbox-recovery": "node --test scripts/retreat-outbox-recovery.test.mjs",
    "test:retreat-inference-budget": "node --test scripts/retreat-inference-budget.test.mjs",
    "test:retreat-session-expiry": "node --test scripts/retreat-session-expiry.test.mjs",
    "test:retreat-response-fallback": "node --test scripts/retreat-response-fallback.test.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@fisch0920/config": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "portless": "^0.15.6",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.136.1",
    "ws": "8.21.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
