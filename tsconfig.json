{
  "extends": "@fisch0920/config/tsconfig-react",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "work", "worker", "dist"]
}
